{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/aistudio/Paste_*",
      "assets/aistudio/image_*",
      "assets/aistudio/*.mp3",
      "assets/aistudio/*.mp4",
      "assets/aistudio/*.pdf",
      "assets/aistudio/*.md",
      "assets/aistudio/*.json",
      "assets/aistudio/*.html",
      "assets/aistudio/*.js",
      "assets/aistudio/*.css",
      "assets/aistudio/Cyan-gold_*",
      "assets/aistudio/Futuristic_*",
      "assets/aistudio/Geometric_*",
      "assets/aistudio/RaOne_R_Play_*",
      "assets/aistudio/raone-vision-gen-*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=(), usb=()" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "raone-ai-backend",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/published/**",
        "run": {
          "serviceId": "raone-ai-backend",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/vision/shared/**",
        "run": {
          "serviceId": "raone-ai-backend",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/privacy-policy",
        "run": {
          "serviceId": "raone-ai-backend",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/terms-of-service",
        "run": {
          "serviceId": "raone-ai-backend",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
