rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidNonEmptyText(val, maxLen) {
      return val is string && val.trim().size() >= 1 && val.size() <= maxLen;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('displayName' in data) || isValidNonEmptyText(data.displayName, 120))
        && (!('email' in data) || (
          data.email is string
          && data.email.size() >= 3
          && data.email.size() <= 254
          && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && (request.auth.token.email == null || data.email == request.auth.token.email)
        ));
    }

    function isValidConversation(data, conversationId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'modelId', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == conversationId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && isValidNonEmptyText(data.title, 200)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('modelId' in data) || isValidNonEmptyText(data.modelId, 100));
    }

    function isValidProject(data, projectId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == projectId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && isValidNonEmptyText(data.name, 160)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['ownerId', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'theme', 'selectedModel', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.updatedAt is timestamp
        && (!('theme' in data) || data.theme in ['dark', 'light', 'system'])
        && (!('selectedModel' in data) || isValidNonEmptyText(data.selectedModel, 100));
    }

    function isValidStudioApp(data, appId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == appId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && isValidNonEmptyText(data.title, 200)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserDocument(data, docId, userId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == docId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == userId
        && isValidNonEmptyText(data.title, 240)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Per-user profile & owned subcollections (PII isolated to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /conversations/{conversationId} {
        allow get: if isValidId(userId) && isValidId(conversationId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(conversationId)
          && isVerifiedOwner(userId)
          && isValidConversation(incoming(), conversationId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(conversationId)
          && isVerifiedOwner(userId)
          && isValidConversation(incoming(), conversationId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'modelId', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(conversationId) && isVerifiedOwner(userId);
      }

      match /projects/{projectId} {
        allow get: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(projectId)
          && isVerifiedOwner(userId)
          && isValidProject(incoming(), projectId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(projectId)
          && isVerifiedOwner(userId)
          && isValidProject(incoming(), projectId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(projectId) && isVerifiedOwner(userId);
      }

      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(settingId)
          && isVerifiedOwner(userId)
          && isValidUserSettings(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(settingId)
          && isVerifiedOwner(userId)
          && isValidUserSettings(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'selectedModel', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(settingId) && isVerifiedOwner(userId);
      }

      match /studioApps/{appId} {
        allow get: if isValidId(userId) && isValidId(appId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(appId)
          && isVerifiedOwner(userId)
          && isValidStudioApp(incoming(), appId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(appId)
          && isVerifiedOwner(userId)
          && isValidStudioApp(incoming(), appId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(appId) && isVerifiedOwner(userId);
      }

      match /documents/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && isVerifiedOwner(userId)
          && isValidUserDocument(incoming(), docId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(docId)
          && isVerifiedOwner(userId)
          && isValidUserDocument(incoming(), docId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isVerifiedOwner(userId);
      }
    }

    // Read-only public platform policies & showcase metadata (point reads only; no collection scraping)
    match /public_policies/{policyId} {
      allow get: if isValidId(policyId);
      allow list: if false;
      allow write: if false;
    }

    // Startup connection validation probe
    match /test/connection {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false;
    }

    // Backend Admin-SDK-only multi-tenant & system collections (zero direct client SDK access)
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if false;
    }

    match /shared/{document=**} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /billing/{docId} {
      allow read, write: if false;
    }

    match /webhooks/{docId} {
      allow read, write: if false;
    }
  }
}
