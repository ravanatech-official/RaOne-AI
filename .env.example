# ==============================================================================
# RaOne AI — Environment Configuration Example (No Secrets Committed)
# ==============================================================================
# Copy to .env for local development. In production (Cloud Run), inject secret
# values via Google Cloud Secret Manager and non-secret values via Cloud Run env.

# ------------------------------------------------------------------------------
# 1. Server Runtime & Persistence Mode
# ------------------------------------------------------------------------------
# 'development' locally | 'production' on Cloud Run
NODE_ENV=development
# Local dev default: 3000 | Cloud Run sets PORT=8080 automatically
PORT=3000

# Persistence backend mode:
# - 'local': Uses ./data/tenants/<tenantId>/... on local disk (no GCP billing needed)
# - 'cloud': Uses Cloud Firestore + Google Cloud Storage (strict, no local fallback)
STORAGE_BACKEND=local

# Google Cloud Storage bucket for permanent binary media (required when STORAGE_BACKEND=cloud)
# Example: raoneai-media-prod
GCS_BUCKET_NAME=

# ------------------------------------------------------------------------------
# 2. Firebase & Authentication Security
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=raoneai
# Production MUST set REQUIRE_FIREBASE_AUTH=true. Local dev may set false for guest mode.
REQUIRE_FIREBASE_AUTH=false

# Explicit comma-separated CORS & origin allowlist (production + custom domains)
ALLOWED_ORIGINS=https://raoneai.web.app,https://raoneai.firebaseapp.com

# Stable 32+ byte secret used for AES-256-GCM BYOK/Plugin vault & HMAC media session signing.
# WARNING: Never rotate without re-encrypting stored BYOK/Plugin credentials.
TENANT_ENCRYPTION_SECRET=

# Optional local service account path / JSON for testing cloud mode outside Cloud Run.
# In Cloud Run production, leave unset so Application Default Credentials (ADC) are used.
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Firebase Local Emulator Suite hosts (for local cloud-like testing)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# ------------------------------------------------------------------------------
# 3. Server-Side AI Provider Keys (Inject via Secret Manager in Production)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=qwen/qwen3-coder:free
FAL_KEY=
HF_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
COMET_API_KEY=
COMET_API_BASE_URL=https://api.cometapi.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Billing & Hosted Checkout Links (Polar.sh / LemonSqueezy)
BILLING_WEBHOOK_SECRET=
CHECKOUT_URL_PLUS_MONTHLY=
CHECKOUT_URL_PLUS_YEARLY=
CHECKOUT_URL_ULTIMATE_MONTHLY=
CHECKOUT_URL_ULTIMATE_YEARLY=
CHECKOUT_URL_PACK_1K=
CHECKOUT_URL_PACK_3500=

# Local LLM controls (should remain disabled in Cloud Run production)
ALLOW_LOCAL_LLM_LOOPBACK=true
ALLOW_LOCAL_LLM_PROCESS=false

# ------------------------------------------------------------------------------
# 4. Frontend Build-Time Public Configuration (VITE_* — NEVER put secrets here)
# ------------------------------------------------------------------------------
# Leave VITE_API_BASE_URL empty to use relative /api/... routing via Firebase Hosting rewrites.
# Only set if intentionally calling a separate backend origin directly.
VITE_API_BASE_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=raoneai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=raoneai
VITE_FIREBASE_STORAGE_BUCKET=raoneai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=